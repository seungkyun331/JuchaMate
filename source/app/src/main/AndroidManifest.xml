<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:name="android.hardware.type.automotive"
        android:required="false" />

    <!-- Pleos Vehicle SDK: steering angle, gear, VIN, door. All read-only. -->
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />
    <uses-permission android:name="pleos.car.permission.READ_CAR_STEERING" />
    <uses-permission android:name="pleos.car.permission.CAR_POWERTRAIN" />
    <uses-permission android:name="pleos.car.permission.CAR_INFO" />
    <uses-permission android:name="pleos.car.permission.CAR_SPEED" />
    <!-- Whether the driver's door is open: guidance stops while someone is getting out to look. -->
    <uses-permission android:name="pleos.car.permission.CAR_DOORS" />
    <!-- Android Automotive car service: vehicle speed, the selected gear and the car's dimensions. -->
    <uses-permission android:name="android.car.permission.CAR_SPEED" />
    <uses-permission android:name="android.car.permission.CAR_INFO" />
    <uses-permission android:name="android.car.permission.CAR_POWERTRAIN" />
    <!-- Where the car is, only to save a place to practise at when the driver asks. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Pleos TextToSpeech SDK: spoken guidance. -->
    <uses-permission android:name="pleos.car.permission.TTS_SERVICE" />
    <!-- A small guidance window that stays up while the car's rear camera has the screen in reverse.
         Given by the driver in the system's settings; without it only that window is missing. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <application
        android:name=".App"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ParkCoach">

        <!-- Present on cars, absent on phones and tablets, where the demo car is used instead. -->
        <uses-library
            android:name="android.car"
            android:required="false" />

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:screenOrientation="sensorLandscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- A parking aid has to stay on screen while the car moves. Guidance stops above 15 km/h. -->
            <meta-data
                android:name="distractionOptimized"
                android:value="true" />
        </activity>
    </application>

</manifest>
